<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <OutputPath>..\Assemblies</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>

  <!-- Adjust RimWorldPath/RimWorldDataPath below to match your own install location.
       RimWorldDataPath is separate from RimWorldPath specifically because the two can
       point at different-vintage installs: vanilla's own Assembly-CSharp/UnityEngine
       assemblies need to match whatever build is actually being played against (a
       stale reference already caused one real bug - a HarmonyException from an
       ambiguous MechRepairUtility.RepairTick overload that only exists in a newer
       build than what this project was originally set up against), while the
       Mods-relative paths below (Harmony, Big and Small) aren't affected by base-game
       version drift and don't need to move in lockstep. -->
  <PropertyGroup>
    <RimWorldPath>C:\Program Files (x86)\Steam\steamapps\common\RimWorld</RimWorldPath>
    <RimWorldDataPath>C:\Program Files (x86)\Steam\steamapps\common\RimWorld</RimWorldDataPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDataPath)\RimWorldWin64_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldDataPath)\RimWorldWin64_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldDataPath)\RimWorldWin64_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldDataPath)\RimWorldWin64_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(RimWorldPath)\Mods\2009463077\Current\Assemblies\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BigAndSmall">
      <HintPath>$(RimWorldPath)\Mods\2925432336\1.6\Base\Assemblies\BigAndSmall.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- AV Framework (Work Queen) is an optional/soft dependency - deliberately NOT
         referenced here. All AV Framework interop is done purely via reflection
         (AccessTools.TypeByName + Traverse) in OverseerGizmoSuppressionPatches.cs,
         manually attached from HarmonyInit.cs only after confirming the types resolve
         at runtime. A compile-time reference would put AV Framework types in a
         Harmony-discovered method signature, which risks reflection failures across
         the whole assembly (including our vanilla-only patches) when AV Framework
         isn't installed. -->
  </ItemGroup>

</Project>
